# ── macOS ──────────────────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Windows ────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor / IDE ───────────────────────────────────────
*.swp
*.swo
*~
.idea/
.vscode/

# ── Talksmith render residue (build artifacts) ─────────
# Rasterized critique previews produced during rendering
**/.critique/
# Font-config scratch dir left by the render pipeline
.fc-tmp/
# LibreOffice / render locks and temp files
**/.~lock.*#
*.tmp

# ── PPTX render intermediates (keep only final.pptx) ───
**/output/*.bak
**/output/*.bak.*
**/output/final.prefix.bak
**/output/final.intermediate.md
**/output/final.work.pptx
**/output/final.fixed.pptx
**/output/final.spcfix.pptx
**/output/final.pdf

# ── Reverse-pipeline artifacts (regenerated from final.pptx) ─────
# talksmith:pptx-extract / pptx-diff / pptx-merge write here — always
# derivable from the deck, never a source of truth.
**/reconcile/

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# --- Talksmith --- (regenerable build artifacts & caches — keep out of Git)
.DS_Store
.venv/
__pycache__/
*.pyc
talks/*/output/*
!talks/*/output/html/
talks/*/images/.critique/
.icons/
.claude/settings.local.json
